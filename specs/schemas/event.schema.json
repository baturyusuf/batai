{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batai Event",
  "type": "object",
  "required": [
    "id",
    "type",
    "timestamp",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}